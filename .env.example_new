# GLORY2YAHPUB - Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================

# Environment: development or production
FLASK_ENV=development

# Secret key for session management (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=glory2yahpub_secret_2024_change_in_production

# Server port
PORT=8080

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite (Development)
DATABASE_URL=sqlite:///instance/glory2yahpub.db

# PostgreSQL (Production - uncomment and update)
# DATABASE_URL=postgresql://username:password@localhost:5432/glory2yahpub

# ============================================================================
# ADMIN SETTINGS
# ============================================================================

# Admin WhatsApp number
ADMIN_WHATSAPP=+50942882076

# Admin pseudo (login identifier — default = ADMIN_WHATSAPP)
ADMIN_PSEUDO=+50942882076

# Admin display name
ADMIN_NAME=Administrateur Glory2Yah

# Admin password (CHANGE THIS IN PRODUCTION!)
ADMIN_PASSWORD=StanGlory2YahPub1986

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# Redis (for caching and sessions)
# REDIS_URL=redis://localhost:6379

# Facebook Integration
# FACEBOOK_PAGE_TOKEN=your_facebook_page_token
# FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token
# FACEBOOK_APP_ID=your_app_id
# FACEBOOK_APP_SECRET=your_app_secret

# Email Configuration
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================

# Sentry (error tracking)
# SENTRY_DSN=your_sentry_dsn

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: FILE UPLOAD SETTINGS
# ============================================================================

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=100

# Allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,mp4,avi,mov,mkv

# ============================================================================
# OPTIONAL: SECURITY SETTINGS
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Session timeout (in minutes)
SESSION_TIMEOUT=1440

# ============================================================================
# OPTIONAL: PAYMENT GATEWAY
# ============================================================================

# Stripe
# STRIPE_PUBLIC_KEY=your_public_key
# STRIPE_SECRET_KEY=your_secret_key

# PayPal
# PAYPAL_CLIENT_ID=your_client_id
# PAYPAL_CLIENT_SECRET=your_client_secret

# ============================================================================
# OPTIONAL: DEPLOYMENT SETTINGS
# ============================================================================

# For Render.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# For Heroku
# HEROKU_APP_NAME=your-app-name

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit .env file to version control
# 2. Always use strong passwords in production
# 3. Use environment-specific values for each deployment
# 4. Keep sensitive information secure
# 5. Rotate secrets regularly
# 6. Use managed services for sensitive data (AWS Secrets Manager, etc.)
