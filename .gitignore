# Render Persistent Data Folder (mountPath=/opt/render/project/src/instance)
# Contains: SQLite (dev), uploads, sessions, logs, .flask_secret_key
# MUST NOT be committed — data changes per deploy and contains user PII/photos
instance/
instance/*
!/instance/.gitkeep
# Staging: raw uploads BEFORE committing a verified path into PostgreSQL
# (anti-corruption belt + suspenders — never commit user media binaries)
instance/uploads_staging/
instance/uploads_backup/
instance/stage_guard_*.txt
instance/.uploads_persistent_marker.txt
instance/.staging_integrity_*.md5

# Local persistence test artifacts (not for repo)
_test_config_persistence.py
_persist_test_out.txt
