# Glory2YahPub Environment Configuration
# Copy this to .env and fill in your values

# Environment (development, staging, production)
FLASK_ENV=development

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database
# Development (SQLite)
DEV_DATABASE_URL=sqlite:///instance/glory2yahpub_dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost/glory2yahpub

# Redis
REDIS_URL=redis://localhost:6379/0

# Admin
ADMIN_PASSWORD=glory2yahpub2024
ADMIN_WHATSAPP=+50942882076

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry (Error Tracking - Optional)
SENTRY_DSN=

# Port
PORT=8080
