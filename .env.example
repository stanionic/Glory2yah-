# Glory2YahPub Environment Configuration
# Copy this to .env and fill in your values

# Environment (development, staging, production)
FLASK_ENV=development

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database
# Development default (SQLite, persistent in instance/)
DEV_DATABASE_URL=sqlite:///instance/glory2yahpub_dev.db

# PostgreSQL (Production — and recommended for local dev). Uncomment + adapt.
# Render's legacy `postgres://` DSN is auto-converted to `postgresql://` at
# startup, so you can paste the Render DB connection string verbatim below.
# DATABASE_URL=postgresql://glory2yahpub:CHANGE_ME@localhost:5432/glory2yahpub
#
# Force SSL/TLS for managed Postgres (Render external, Neon, Supabase, ...).
# Only appended when the URL above does not already contain an `sslmode` param.
# DATABASE_SSLMODE=require
#
# Optional per-worker connection pool tuning (defaults are safe for Render + gunicorn -w 4):
# DB_POOL_SIZE=4
# DB_MAX_OVERFLOW=6

# Redis
REDIS_URL=redis://localhost:6379/0

# Public/public-facing URL used for canonical links, Open Graph metadata,
# and absolute image/share URLs. Set this after the custom domain is verified.
# SITE_URL=https://glory2yah.net
# PUBLIC_BASE_URL=https://glory2yah.net

# Admin (par défaut DEV/DEMO — CHANGE in production: set vars dans .env)
#   Pseudo / WhatsApp = +50942882076   (saisir "+50942882076" dans champ `identifier`)
#   Password          = StanGlory2YahPub1986
ADMIN_PASSWORD=StanGlory2YahPub1986
ADMIN_WHATSAPP=+50942882076
ADMIN_PSEUDO=+50942882076
ADMIN_NAME=Glory2YahPub

# ============================================================================
# ADMIN APPROVAL ALERTS (WhatsApp + in-app)
# ----------------------------------------------------------------------------
# Every traffic awaiting admin approval (new ad, fee proof, GKACH
# recharge/withdrawal, MENNEN driver, event organization, bank loan, seller
# certification) alerts ADMIN_WHATSAPP and the admin notification centre.
# Master switch for the WhatsApp channel:
ADMIN_WHATSAPP_ALERTS=1
# Configure at least ONE provider (first configured wins):
# 1) CallMeBot (free) — register the number once at
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=
# 2) UltraMsg — https://ultramsg.com
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# 3) Meta WhatsApp Cloud API (official)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
# 4) Generic bridge/webhook — receives POST JSON {"to": "...", "text": "..."}
WHATSAPP_ALERT_WEBHOOK_URL=
# Optional absolute public base URL for clickable links inside the alerts
# PUBLIC_BASE_URL=https://glory2yahpub.com

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry (Error Tracking - Optional)
SENTRY_DSN=

# Port
PORT=8080
