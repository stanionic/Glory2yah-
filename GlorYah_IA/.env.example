# MANDEMMAPBAW Configuration
# IMPORTANT: Copier ce fichier en .env et changer les valeurs

FLASK_APP=app.py
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Générer une nouvelle clé avec: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///mandemmapbaw.db

# Debug mode (True pour développement, False pour production)
DEBUG=True
